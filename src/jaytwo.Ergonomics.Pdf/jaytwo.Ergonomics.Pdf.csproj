<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net6.0;netstandard2.0</TargetFrameworks>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Workflows over the jaytwo.Pdf engine: describe changes to an existing PDF, then run them as one incremental revision with explicit ownership, ordering, and output handling.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Pdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Pdf</RepositoryUrl>
    <PackageTags>pdf;acroform;signature;pkcs11;timestamp;metadata;attachments;jaytwo;ergonomics</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\jaytwo.Pdf\jaytwo.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>

</Project>
