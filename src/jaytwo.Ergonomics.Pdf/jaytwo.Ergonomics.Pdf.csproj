<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net6.0;netstandard2.0</TargetFrameworks>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Stream-native PDF operations: AcroForm fill, PKCS#11 and TSA sealing, field geometry, metadata, attachments, and password-based RC4 and AES encryption. No third-party runtime dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Pdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Pdf</RepositoryUrl>
    <PackageTags>pdf;acroform;signature;pkcs11;timestamp;metadata;attachments;jaytwo;ergonomics</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="jaytwo.Ergonomics.Pdf.Tests" />
    <InternalsVisibleTo Include="jaytwo.Ergonomics.Pdf.NetStandard.Tests" />
    <InternalsVisibleTo Include="jaytwo.Ergonomics.Pdf.Fuzz" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>

</Project>
