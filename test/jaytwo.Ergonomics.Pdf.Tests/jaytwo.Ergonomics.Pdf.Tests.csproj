<Project Sdk="Microsoft.NET.Sdk">

  <!-- D-54: public workflow behavior only. Engine tests, which may use jaytwo.Pdf internals, are in jaytwo.Pdf.Tests. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net6.0</TargetFrameworks>
    <!-- net48 needs the .NET Framework test host, so it runs on Windows only. The Linux CI image has no Mono. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\jaytwo.Ergonomics.Pdf\jaytwo.Ergonomics.Pdf.csproj" />
  </ItemGroup>

  <!-- W-142: engine test helpers that use only the public jaytwo.Pdf API. TestCompat.cs here stands in for theirs. -->
  <ItemGroup>
    <Compile Include="..\jaytwo.Pdf.Tests\DssCases.cs" Link="Shared\DssCases.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\ExternalTool.cs" Link="Shared\ExternalTool.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\KeySigner.cs" Link="Shared\KeySigner.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\Lane.cs" Link="Shared\Lane.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\OpenSslTimestampAuthority.cs" Link="Shared\OpenSslTimestampAuthority.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\PdfBuilder.cs" Link="Shared\PdfBuilder.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\Pdfsig.cs" Link="Shared\Pdfsig.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\ProbeStream.cs" Link="Shared\ProbeStream.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\StandardEncryptor.cs" Link="Shared\StandardEncryptor.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\TestPdfSource.cs" Link="Shared\TestPdfSource.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\TestKeys.cs" Link="Shared\TestKeys.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="..\jaytwo.Pdf.Tests\G7Fixtures.cs" Link="Shared\G7Fixtures.cs" />
    <Compile Include="..\jaytwo.Pdf.Tests\WorkloadMeter.cs" Link="Shared\WorkloadMeter.cs" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\jaytwo.Pdf.Tests\Fixtures\validate_signature.py;..\jaytwo.Pdf.Tests\Fixtures\validate_doc_timestamp.py;..\jaytwo.Pdf.Tests\Fixtures\certify_samples.py" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The linked OpenSslTimestampAuthority is in the engine tests' global usings. -->
  <ItemGroup>
    <Using Include="jaytwo.Pdf.Signatures" />
    <Using Include="jaytwo.Pdf.AcroForm" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- The .NET Framework test host redirects Unsafe to 6.0.0.0; ship that version so the redirect resolves. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

</Project>
